__pycache__/
*.pyc
.pytest_cache/
.hypothesis/
mutants/
.mutmut-cache

# Package A (review-secondary/final-gap-plan-9.5-2026-09-09.pdf): sdist/
# wheel build output (`python -m build`) -- regenerable from pyproject.toml
# + the source files it names, same "regenerable build output" policy as
# out/ below.
dist/
build/
*.egg-info/

# Regenerable build output, same policy as sarc-suite-one-pass's own
# .gitignore: everything under out/ is reproducible from the pinned
# siblings (engines.lock) + the frozen seed list (prereg/seeds.json) +
# this repo's code, so raw per-decision logs are not committed. Small
# aggregated summaries later steps read directly ARE committed as an
# exception -- see the negated patterns below.
out/*
!out/metrics.json
!out/quality.json
!out/results/
!out/checkers/

# Small LaTeX build byproducts (paper-tex/), same policy as
# sarc-suite-one-pass's own .gitignore: regenerable by `make arxiv`
# (Tectonic) from main.tex + refs.bib, no standalone value of their own.
# main.pdf, main.bbl, arxiv.tar.gz, parity-report.json, and refs.bib
# are NOT ignored -- each has standalone value (the built PDF, the
# generated bibliography, the packaged arXiv submission, the gate
# report, and the citation source respectively) and are committed.
paper-tex/main.aux
paper-tex/main.blg
paper-tex/main.fdb_latexmk
paper-tex/main.fls
paper-tex/main.log
paper-tex/main.out
paper-tex/main.synctex.gz
paper-tex/main.toc
paper-tex/texput.log
paper-tex/gates/__pycache__/
